# ==============================================================================
# FILE: .env.production.example
# ARCHITECTURE ROLE: Enterprise Production Environment Variables & Secrets Blueprint
#
# 🎓 BEGINNER'S GUIDE TO ENVIRONMENT VARIABLES IN CLOUD DEPLOYMENTS:
#   1. What is the difference between Public and Private variables?
#      • PUBLIC (Prefix: `NEXT_PUBLIC_*`):
#        Baked into the client JavaScript bundle during `npm run build`.
#        Anyone can view them by inspecting browser sources. Use ONLY for non-sensitive data
#        like your store name or Stripe Publishable Key!
#      • PRIVATE (No Prefix):
#        Available ONLY inside Node.js on the server. The user's browser NEVER sees them.
#        Use for database passwords, Stripe Secret Keys, and webhook signing secrets!
#
#   2. The Golden Security Rule:
#      NEVER commit real `.env.production` or `.env.local` files to Git!
#      Only commit this `.example` file as a reference template for production setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & STOREFRONT METADATA (PUBLIC)
# ------------------------------------------------------------------------------
# Exposed to the browser for page titles and SEO metadata
NEXT_PUBLIC_STORE_NAME="NOVA Storefront"
NEXT_PUBLIC_SITE_URL="https://nova-storefront.vercel.app"
NEXT_PUBLIC_API_VERSION="v1"

# ------------------------------------------------------------------------------
# 2. RUNTIME & SERVER CONFIGURATION (PRIVATE)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# ------------------------------------------------------------------------------
# 3. RELATIONAL DATABASE (POSTGRESQL + PRISMA) (PRIVATE)
# ------------------------------------------------------------------------------
# Connection pool URI for Supabase, Neon, AWS RDS, or Docker PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=20
DATABASE_URL="postgresql://nova_admin:REPLACE_WITH_SECURE_PASSWORD@postgres.internal.net:5432/nova_db?schema=public"

# ------------------------------------------------------------------------------
# 4. HIGH-PERFORMANCE DATA LAYER & CACHE (REDIS) (PRIVATE)
# ------------------------------------------------------------------------------
# Connection string for Upstash Redis, AWS ElastiCache, or Docker Redis
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@redis.internal.net:6379"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (STRIPE FINANCIAL INTEGRATION)
# ------------------------------------------------------------------------------
# Public publishable key for browser tokenization (Safe for client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_REPLACE_WITH_STRIPE_PUBLISHABLE_KEY"

# Private master secret key for server-side PaymentIntent creation (NEVER EXPOSE TO CLIENT)
STRIPE_SECRET_KEY="sk_live_REPLACE_WITH_STRIPE_SECRET_KEY"

# Cryptographic signing secret for HMAC-SHA256 webhook verification
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET"

# ------------------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE & LLM RETRIEVAL (PRIVATE)
# ------------------------------------------------------------------------------
AI_MODEL_NAME="gemini-1.5-flash"
AI_INFERENCE_API_KEY="REPLACE_WITH_AI_API_TOKEN"
AI_PROMPT_CACHE_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY, LOGGING & ERROR TRACKING
# ------------------------------------------------------------------------------
# Log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"

# Sentry DSN for production crash reporting and stack trace tracking
NEXT_PUBLIC_SENTRY_DSN="https://REPLACE_WITH_SENTRY_PUBLIC_KEY@o000000.ingest.sentry.io/0000000"

# ------------------------------------------------------------------------------
# 8. EXTERNAL WAREHOUSE & WEBHOOK SECURITY (PRIVATE)
# ------------------------------------------------------------------------------
# Secret token authenticating incoming inventory webhooks from BigCommerce or ERP
INVENTORY_WEBHOOK_SECRET="whsec_prod_warehouse_sync_secret_2026"
