# ==============================================================================
# NOVA STOREFRONT ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. LIVE AI COPILOT CONFIGURATION (Google Gemini / OpenAI)
# Get a free Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Alternatively, you can use an OpenAI API Key:
OPENAI_API_KEY=

# 2. STRIPE FINANCIAL PAYMENTS & WEBHOOKS
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# 3. DATABASE CONFIGURATION (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/nova_storefront

# 4. REDIS CACHE (Upstash / Local Redis)
REDIS_URL=redis://localhost:6379

